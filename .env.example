# Veerox environment configuration — ONE schema (apps/api/config.py's
# Settings) shared by every deployment: the central owner deployment and
# every separate client deployment alike. There is no separate config
# format per deployment type — copy this file to `.env`, set
# DEPLOYMENT_MODE, and fill in the values that section needs. A client
# deployment's `.env` looks exactly like this one, just with different
# values (its own database, its own deployment identity, no signing
# private key) — see the "DEPLOYMENT_MODE=client" section below and
# infra/client-template/README.md for the full onboarding walkthrough.
#
# Never commit a filled-in `.env`.

# =============================================================================
# Deployment mode — read this first
# =============================================================================
# "owner"  (default): the central Veerox platform deployment. Runs the
#          owner panel/API (org directory, licence issuance, feature
#          allocation, deployment registration/sync) in addition to the
#          normal product. Exactly one of these should exist.
# "client": a separate, isolated deployment for one client org, with its own
#          database and secrets. Never registers owner administration API
#          routes (enforced server-side in apps/api/main.py, not just a
#          hidden frontend link) — it only runs the product itself, gated by
#          direct authenticated HTTPS licence validation against
#          LICENSE_API_URL (no signed token, no local signature). Every
#          client gets its own copy of this file with its own values.
#
# apps/api/config.py validates the fields below according to this value at
# startup (a client deployment fails to start if it's missing LICENSE_API_URL
# or LICENSE_API_TOKEN).
DEPLOYMENT_MODE=owner

# =============================================================================
# App
# =============================================================================
ENVIRONMENT=dev
LOG_LEVEL=INFO
# The platform's own seeded org (owner mode) or this org's central reference
# (client mode — set this to the `central_org_ref` value returned by
# POST /platform/organizations on the owner API when this client was created).
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
# Shared secret for the legacy admin-token bootstrap path. Every deployment
# (owner and each client) generates its OWN random value here — never reuse
# the owner's ADMIN_TOKEN on a client, and never reuse one client's token on
# another. Generate with: openssl rand -hex 32
ADMIN_TOKEN=

SESSION_TTL_SECONDS=1209600
REQUIRE_SESSION_AUTH=true

# =============================================================================
# Database / Redis — ALWAYS this deployment's own, never shared
# =============================================================================
# Owner: the central platform database. Client: this client's own isolated
# database (its own logical database + restricted role, or its own dedicated
# instance — see infra/client-template/README.md's isolation tiers). Never
# point a client's DATABASE_URL at the owner's database or another client's.
DATABASE_URL=postgresql+asyncpg://veerox:veerox@localhost:5432/veerox
REDIS_URL=redis://localhost:6379/0
DB_ECHO=false
STARTUP_SEED_REQUIRED=false
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# =============================================================================
# Secrets — ALWAYS generated fresh per deployment
# =============================================================================
# Fernet key encrypting per-org provider secrets (Plivo/Twilio/Meta/OpenAI
# credentials an org brings itself — see core/crypto.py). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Every deployment (owner, each client) generates its own — never copy the
# owner's value onto a client or vice versa; existing ciphertext under one
# key is unreadable under another.
SECRET_ENCRYPTION_KEY=

# =============================================================================
# Central licence management (spec: multi-tenant licensing)
# =============================================================================
# A client deployment validates its licence directly against the owner over
# authenticated HTTPS (GET /platform/license) — there is no signed token and
# no signing keypair anywhere in this design; trust comes from HTTPS + the
# bearer token below, not embedded cryptography. See
# apps/api/core/license_cache.py.
#
# --- Client-only — required when DEPLOYMENT_MODE=client, unused on the owner ---
# The owner API's own base URL, e.g. https://api.workassignai.com
LICENSE_API_URL=
# This deployment's own bearer token, issued once by
# POST /platform/organizations/{id}/deployments on the owner API (shown
# exactly once at generation — the owner only ever stores its hash; if lost,
# rotate it with POST .../deployments/reissue-token rather than trying to
# recover it). Sent as `Authorization: Bearer <token>` on every call to the
# owner API — never exposed to the frontend, browser storage, URLs, or logs.
LICENSE_API_TOKEN=

# =============================================================================
# OpenAI
# =============================================================================
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy

# =============================================================================
# Voice — ElevenLabs (optional TTS swap) + call tuning
# =============================================================================
VOICE_TTS_PROVIDER=openai
VOICE_LIVE_TURN_DETECTION=true
VOICE_LIVE_TRANSCRIBE_MODEL=gpt-live-transcribe
VOICE_LIVE_TRANSCRIBE_DELAY=minimal
VOICE_INTERRUPTION_MODE=answer_now
VOICE_VAD_SILENCE_MS=300
VOICE_ENDPOINT_HOLD=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=CwhRBWXzGAHq8TQ4Fs17
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# =============================================================================
# Plivo / Twilio (calling)
# =============================================================================
# This deployment's own calling provider account — a client brings/pays for
# its own, same as the owner does for itself. Never share one account's
# credentials across deployments.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
MAX_CONCURRENT_CALLS=50

# =============================================================================
# Brevo (transactional email)
# =============================================================================
BREVO_API_KEY=
APP_LOGIN_URL=https://app.workassignai.com/login
BREVO_SENDER_EMAIL=no-reply@veerox.ai
BREVO_SENDER_NAME=Veerox

# =============================================================================
# Meta WhatsApp Cloud API
# =============================================================================
META_APP_ID=
META_APP_SECRET=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_ACCESS_TOKEN=
META_GRAPH_API_VERSION=v21.0

# =============================================================================
# Networking
# =============================================================================
# This deployment's own public URL (Plivo <Stream> callback, Meta webhook
# registration) — a client sets its own domain here, never the owner's.
PUBLIC_BASE_URL=https://api.example.com
# This deployment's own frontend origin(s) — a client sets its own domain
# here, never the owner's.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# =============================================================================
# Observability
# =============================================================================
# This deployment's own Sentry project — a client's errors should not land
# in the owner's Sentry project (or vice versa).
SENTRY_DSN=
