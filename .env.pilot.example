# VEEROX PILOT - example only. Copy to .env.pilot (git-ignored), fill in, and run:
#   $env:VEEROX_ENV_FILE = (Resolve-Path .env.pilot)
# Placeholders only. NEVER paste production values here. Anything left out stays at the code default, and with
# VEEROX_ENV_FILE set the real .env is NOT read, so a missing line can never borrow a production credential.

# --- identity of this environment (these switch on the pilot guard rails) --------------------------------------
ENVIRONMENT=pilot
PILOT_DATABASE_NAME=veerox_pilot
# comma-separated test phones you hold. EMPTY = every call/SMS/WhatsApp is refused
PILOT_ALLOWED_NUMBERS=+91XXXXXXXXXX
# comma-separated; EMPTY = every e-mail (including login codes) is refused
PILOT_ALLOWED_EMAILS=you@example.com
# false = no campaign dialer, dispatchers, billing jobs or Plivo re-registration
PILOT_WORKERS_ENABLED=false
PLIVO_STARTUP_REGISTRATION=false
# PILOT_FORBIDDEN_HOSTS=host-fragment-1,host-fragment-2   # optional extra fragments the preflight must never see

# --- call safeguards for a paid test call (0 = off) --------------------------------------------------------------
# Refuse a second outbound call in the same run.
PILOT_MAX_OUTBOUND_CALLS=1
# Ask the telephony provider to end the call itself after this many seconds, and to stop ringing after the second value.
VOICE_OUTBOUND_TIME_LIMIT_SECONDS=120
VOICE_OUTBOUND_RING_TIMEOUT_SECONDS=25

# --- data stores: a NEW disposable database and a SEPARATE Redis instance --------------------------------------
DATABASE_URL=postgresql+asyncpg://PILOT_USER:PILOT_PASSWORD@PILOT_HOST/veerox_pilot
REDIS_URL=rediss://default:PILOT_REDIS_PASSWORD@PILOT_REDIS_HOST:6379
TEST_DATABASE_URL=sqlite+aiosqlite:///:memory:

# --- app --------------------------------------------------------------------------------------------------------
ADMIN_TOKEN=generate-a-new-random-value
SECRET_ENCRYPTION_KEY=generate-a-new-key-not-the-production-one
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001
PUBLIC_BASE_URL=https://your-pilot-tunnel.ngrok-free.dev
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
LOG_LEVEL=INFO
MAX_CONCURRENT_CALLS=2

# --- AI and voice: use keys with their own low spending limits ---------------------------------------------------
OPENAI_API_KEY=sk-pilot-placeholder
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_CHAT_MODEL=<same as production>
VOICE_TTS_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=pilot-placeholder
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_VOICE_ID=<voice id>

# --- telephony: a TEST number/sub-account only. Leave blank to make real calls impossible --------------------------
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- deliberately NOT set in a pilot (leave out; their absence is the safeguard) ----------------------------------
#   META_ACCESS_TOKEN / META_APP_SECRET / META_*  -> no WhatsApp can be sent or received
#   RAZORPAY_*                                    -> no payments or billing webhooks
#   BREVO_API_KEY                                 -> no e-mail leaves the system
#   SENTRY_DSN                                    -> pilot errors do not land in the production project

# --- privacy: keep these for the first pilot ----------------------------------------------------------------------
LOG_PRIVACY_ENABLED=true
LOG_TRANSCRIPTS=false
VOICE_LATENCY_TRACKING=true
# The agent must say it is an AI in its greeting. Never turn this off.
VOICE_GREETING_AI_DISCLOSURE=true
# Plivo webhook signatures + media-stream token. auto = enforced in pilot mode. Use warn to log without rejecting; off only to debug.
PLIVO_SIGNATURE_MODE=auto

# --- experimental voice features: OFF. Enable ONE at a time, after its probe (see docs/local-pilot-runbook.md) ------
VOICE_SMART_TURN_TAKING=false
VOICE_SAFE_CANCEL=false
VOICE_TRIM_INTERRUPTED_CONTEXT=false
VOICE_END_CALL_ENABLED=false
VOICE_METERING_V2=false
VOICE_RETENTION_WORKER_ENABLED=false
VOICE_RETENTION_DELETE_PROVIDER_AUDIO=false
VOICE_RECONNECT_RECOVERY=false
VOICE_TTS_RECOVERY=false
# Phase 8L: play the reviewed greeting from audio synthesised while the phone rings (falls back to the spoken greeting). Enable for the next call after approval.
VOICE_GREETING_AUDIO_CACHE=false
