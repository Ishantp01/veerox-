# Template for a per-client deploy workflow — copy to
# .github/workflows/deploy-client-<slug>.yml and fill in the placeholders
# once that client is provisioned. Mirrors .github/workflows/deploy-aws.yml
# (the owner's own deploy workflow) but targets that client's own directory
# and docker-compose project on the shared host, so a push to main
# redeploys every client the same way the owner app already redeploys
# itself. Split into one workflow per client (rather than one workflow
# looping over all clients) so a failure or a manual redeploy for one client
# never touches another's containers.
#
# Requires these repo secrets, one set per client (suffix with the client
# slug, e.g. AWS_SSH_HOST is already used by deploy-aws.yml for the owner
# app itself — these are the SAME host/user/key, just a different deploy
# path):
#   AWS_SSH_HOST, AWS_SSH_USER, AWS_SSH_KEY  (shared with the owner deploy)
#   {{CLIENT_SLUG_UPPER}}_DEPLOY_PATH        e.g. /home/ubuntu/clients/acme

name: Deploy {{CLIENT_SLUG}} client

on:
  push:
    branches: [main]
  workflow_dispatch: {}

concurrency:
  group: deploy-client-{{CLIENT_SLUG}}
  cancel-in-progress: false

jobs:
  deploy:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - name: SSH deploy
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.AWS_SSH_HOST }}
          username: ${{ secrets.AWS_SSH_USER }}
          key: ${{ secrets.AWS_SSH_KEY }}
          script_stop: true
          script: |
            cd ${{ secrets.{{CLIENT_SLUG_UPPER}}_DEPLOY_PATH }}
            docker compose -f docker-compose.yml build
            docker compose -f docker-compose.yml up -d
            docker compose -f docker-compose.yml exec -T api alembic upgrade head
            docker image prune -f
