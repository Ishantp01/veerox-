# Per-client deployment stack — copy to the client's own directory on the
# host as `docker-compose.yml` and fill in {{PLACEHOLDERS}} (see
# provision_client.sh, which does this substitution for you).
#
# Runs as its OWN docker-compose project (`-p {{CLIENT_SLUG}}`) alongside
# the owner's own docker-compose.yml project on the same EC2 host (shared
# infrastructure by default — see README.md's "isolation tiers" section for
# when a dedicated host is actually justified). Each client project gets
# its own container names/network/ports; only the shared Caddy instance
# (owner's docker-compose.yml) is shared, routing by hostname to whichever
# client's `api`/`web` containers that request's Host header names (see
# Caddyfile.client-block.template).
#
# This client's own app environment, database credentials, and integration
# secrets all come from ./.env — copied from the repo root's .env.example
# (the ONE schema apps/api/config.py's Settings defines, same file the owner
# deployment already uses), just with this client's own values
# (DEPLOYMENT_MODE=client, its own DATABASE_URL, its own LICENSE_API_TOKEN,
# etc — see .env.example's own comments). Exists ONLY on this client's
# slice of the host, never committed, never shared with another client's
# process.

# {{REPO_PATH}} is the SAME shared repository clone the owner app already
# builds from (spec §1: "maintain one shared codebase") — every client runs
# the identical application image, differing only by this stack's own .env
# (DEPLOYMENT_MODE=client, its own DATABASE_URL/LICENSE_API_TOKEN/etc). There is
# no separate per-client git checkout.
services:
  api:
    build:
      context: {{REPO_PATH}}
      dockerfile: Dockerfile
    env_file: .env
    restart: unless-stopped
    expose:
      - "8002"
    networks:
      - client_net

  web:
    build:
      context: {{REPO_PATH}}/apps/web
      dockerfile: Dockerfile
      args:
        NEXT_PUBLIC_API_URL: ${NEXT_PUBLIC_API_URL}
    restart: unless-stopped
    expose:
      - "3001"
    networks:
      - client_net

networks:
  client_net:
    name: {{CLIENT_SLUG}}_net
